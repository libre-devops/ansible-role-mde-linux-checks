        <mxCell id="c20" value="compare_to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1E3A8A;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c8" target="c15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="What the upgrade checks catch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;container=1;collapsible=0;arcSize=3;" parent="1" vertex="1">
          <mxGeometry x="40" y="730" width="1570" height="400" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;upgrade_version&lt;/b&gt; (Critical)&lt;br&gt;A newer version than the snapshot. The same, or a downgrade, fails." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="20" y="45" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;upgrade_identity&lt;/b&gt; (Critical)&lt;br&gt;machine_guid, edr_machine_id and org_id unchanged: no second device in the portal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="535" y="45" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;upgrade_settings&lt;/b&gt; (High)&lt;br&gt;The settings you name are unchanged, and still managed if they were." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="1050" y="45" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;upgrade_exclusions&lt;/b&gt; (High)&lt;br&gt;The antivirus exclusions are unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="20" y="160" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;upgrade_health_fields&lt;/b&gt; (Medium)&lt;br&gt;mdatp health still reports every field: scripts and monitoring that read one keep working." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="535" y="160" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;upgrade_definitions&lt;/b&gt; (Medium)&lt;br&gt;Security intelligence was not rolled back." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="1050" y="160" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;upgrade_dependencies&lt;/b&gt; (Info)&lt;br&gt;No new package dependencies: offline hosts and Satellite content views need them too." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="20" y="275" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;upgrade_resources&lt;/b&gt; (Info)&lt;br&gt;Memory before and after, as memory_change_percent, for a limit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="535" y="275" width="495" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;upgrade_compared&lt;/b&gt; (High)&lt;br&gt;A snapshot was compared at all. Skipped without one, an error when the file is missing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c21" vertex="1">
          <mxGeometry x="1050" y="275" width="495" height="100" as="geometry" />
        </mxCell>
